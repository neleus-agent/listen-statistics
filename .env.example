# Golden Hour Selector (mcp-spotify): Authorization Code + PKCE (no client secret needed).
# Copy to .env and fill SPOTIFY_CLIENT_ID. NEVER commit .env or the token file.

# Required: your Spotify app Client ID (Spotify Developer Dashboard).
# Redirect URI registered on the app MUST be exactly: http://127.0.0.1:8888/callback
SPOTIFY_CLIENT_ID=

# Optional: where the rotating refresh token is persisted (atomic write).
# Default: ~/.ai/mcp-spotify/spotify.json   (gitignored; keep OUTSIDE any repo).
# SPOTIFY_TOKEN_PATH=

# Optional: audit log dir for playback writes (default: ~/.ai/mcp-spotify/audit).
# SPOTIFY_AUDIT_PATH=

# Optional: local OAuth callback port (default 8888). Must match the registered redirect URI.
# SPOTIFY_CALLBACK_PORT=8888

# Optional: folder for `export` / export_playlists (default: ~/Downloads, as spotify-export-<date>/).
# SPOTIFY_EXPORT_DIR=
